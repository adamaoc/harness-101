# xAI Grok API key
XAI_API_KEY=XXXX

# Optional: model id. When unset, the harness sends "latest" (xAI's rolling
# flagship alias — no version pin in code). Pin only when you need a fixed model:
#   XAI_MODEL=grok-4.5
#   XAI_MODEL=grok-4.3
# XAI_MODEL=latest

# Optional: OpenAI-compatible base URL (default https://api.x.ai/v1)
# XAI_BASE_URL=https://api.x.ai/v1

# The tutorial and this project were built with Grok in mind.
# Any OpenAI-compatible endpoint works: set XAI_API_KEY, XAI_MODEL, and
# optionally XAI_BASE_URL. Add your API key and save this file as .env.
