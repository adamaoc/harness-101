# xAI Grok API key
XAI_API_KEY=XXXX

# Optional: which model to call. Defaults to grok-4.5-latest (xAI rolling alias
# for the current flagship family). Pin a slug when you need a fixed version:
#   XAI_MODEL=grok-4.5
#   XAI_MODEL=grok-4.3
# XAI_MODEL=grok-4.5-latest

# Optional: OpenAI-compatible base URL (default https://api.x.ai/v1)
# XAI_BASE_URL=https://api.x.ai/v1

# The tutorial and this project were built with Grok in mind.
# Any OpenAI-compatible endpoint works: set XAI_API_KEY, XAI_MODEL, and
# optionally XAI_BASE_URL. Add your API key and save this file as .env.
